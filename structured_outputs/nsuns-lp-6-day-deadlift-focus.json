{
  "type": "program",
  "program_id": "n-suns-531-lp",
  "program": {
    "name": "n-Suns 531 LP",
    "author": null,
    "version": "1.0",
    "description": "Weekly 6-day 5/3/1-inspired linear progression using 90% training maxes with AMRAP (1+ / 3+ / 5+ / 8+) sets to drive weekly TM adjustments. Loads shown in pounds.",
    "philosophy": "Set Training Max = 90% of true 1RM. Perform prescribed sets; push AMRAP sets. Adjust Training Max weekly based on AMRAP performance. Assistance is bodybuilding-style and can be customized.",
    "notes": [
      "Units: Lb",
      "Enter 1RMs, TMs auto-calc at 90% of 1RM; manually overwrite TM when progressing.",
      "1RMs: Squat 500, Bench 345, Deadlift 600, Press 225",
      "TMs: Squat 405, Bench 280, Deadlift 500, Press 155"
    ]
  },
  "split_overview": "6-day weekly schedule (Mon–Sat).",
  "schedule": {
    "rotation": null,
    "calendar_map": {
      "Monday": "Monday",
      "Tuesday": "Tuesday",
      "Wednesday": "Wednesday",
      "Thursday": "Thursday",
      "Friday": "Friday",
      "Saturday": "Saturday",
      "Sunday": null
    }
  },
  "calendar": {
    "weeks": 1,
    "repeatable": true,
    "rest_guidance": "Not specified",
    "deload_rules": null
  },
  "progression_rules": [
    {
      "id": "tm-progress-0-1",
      "applies_to_tags": [
        "main"
      ],
      "applies_to_exercises": null,
      "spec": {
        "increase_training_max_lb": 0.0,
        "decrease_training_max_pct": null,
        "per_week_add_lb": 0.0,
        "cap_weeks": null,
        "condition": "If 0–1 reps achieved on the day’s 1+ AMRAP set, do not increase TM."
      },
      "notes": null
    },
    {
      "id": "tm-progress-2-3",
      "applies_to_tags": [
        "main"
      ],
      "applies_to_exercises": null,
